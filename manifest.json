{
  "manifest_version": 3,
  "name": "Inspektr",
  "short_name": "Inspektr",
  "description": "Inspect fonts, colors, images and more on any webpage. A developer toolkit for web designers and engineers.",
  "version": "0.1.1",
  "author": "Inspektr",
  "homepage_url": "https://github.com/laricoDGT/inspektr",

  "icons": {
    "16":  "assets/icons/icon16.png",
    "32":  "assets/icons/icon32.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "32":  "assets/icons/icon32.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Inspektr — Developer Toolkit"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },

  "minimum_chrome_version": "116",

  "web_accessible_resources": [
    {
      "resources": [
        "tools/font-detector/font-detector.js",
        "assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
